{% block javascripts %}
{{ parent() }}
<script>
// ════════════════════════════════════════════════
//   TRAVELMATE — HOMEPAGE JS (parallax + reveal)
//   NB : le JS de l'intro vidéo est un <script> inline
//        placé juste après #home-intro dans le HTML,
//        pour s'exécuter avant tout importmap/bundle.
// ════════════════════════════════════════════════

// ── PARALLAX HERO léger sur la vidéo ─────────────────────────────────────
var heroVid = document.getElementById('hero-bg-video');
window.addEventListener('scroll', function () {
  var y = window.scrollY;
  if (heroVid && y < window.innerHeight * 1.2) {
    heroVid.style.transform = 'scale(1.05) translateY(' + (y * 0.22) + 'px)';
  }
}, { passive: true });

// ── SCROLL REVEAL ─────────────────────────────────────────────────────────
// Classe CSS cible : "vis" (cohérent avec tout le CSS de cette page)
var srEls = document.querySelectorAll('.sr');
var srObs = new IntersectionObserver(function (entries) {
  entries.forEach(function (e) {
    if (e.isIntersecting) {
      e.target.classList.add('vis');
      srObs.unobserve(e.target);
    }
  });
}, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
srEls.forEach(function (el) { srObs.observe(el); });

// Quand l'intro se ferme, ré-observe tous les .sr pas encore visibles
// (ils ont été observés pendant l'intro et potentiellement ratés)
document.addEventListener('introEnded', function () {
  var notYetVisible = document.querySelectorAll('.sr:not(.vis)');
  notYetVisible.forEach(function (el) { srObs.observe(el); });
  // Force un mini-scroll pour déclencher les observers sur les éléments déjà dans le viewport
  window.dispatchEvent(new Event('scroll'));
});

// ── COUNT-UP STATS ────────────────────────────────────────────────────────
function countUp(el, target, suffix, dur) {
  dur = dur || 1800;
  var start = null;
  function step(ts) {
    if (!start) start = ts;
    var p    = Math.min((ts - start) / dur, 1);
    var ease = 1 - Math.pow(1 - p, 3);
    el.innerHTML = Math.round(ease * target) + '<span>' + suffix + '</span>';
    if (p < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}
var statsSection = document.querySelector('.home-stats');
var statsDone    = false;
if (statsSection) {
  new IntersectionObserver(function (entries) {
    if (entries[0].isIntersecting && !statsDone) {
      statsDone = true;
      var nums = statsSection.querySelectorAll('.hstat-num');
      if (nums[0]) setTimeout(function () { countUp(nums[0], 2,   'K+'); }, 200);
      if (nums[1]) setTimeout(function () { countUp(nums[1], 140, '+');  }, 400);
      if (nums[2]) setTimeout(function () { countUp(nums[2], 98,  '%'); }, 600);
    }
  }, { threshold: 0.3 }).observe(statsSection);
}
</script>
{% endblock %}
