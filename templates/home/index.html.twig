{% extends 'base.html.twig' %}

{% block title %}Accueil | TravelMate{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>

/* ═══════════════════════════════════════════════════════
   TRAVELMATE — PAGE ACCUEIL
   Thème : Clair · Chaud · Crème/Orangé
   ═══════════════════════════════════════════════════════ */

:root {
  --home-orange:      #c4673a;
  --home-orange-mid:  #d4794b;
  --home-orange-soft: rgba(196, 103, 58, 0.12);
  --home-cream:       #fdf8f2;
  --home-cream-2:     #f5ede0;
  --home-cream-3:     #efe4d4;
  --home-warm:        #8a6040;
  --home-warm-muted:  rgba(90, 55, 25, 0.48);
  --home-border:      rgba(196, 150, 100, 0.22);
  --home-serif:       'Cormorant Garamond', Georgia, serif;
  --home-sans:        'Outfit', sans-serif;
  --home-radius:      20px;
  --home-shadow:      0 18px 48px rgba(90, 55, 25, 0.09);
}

/* La page d'accueil se scroll normalement — pas de overflow:hidden */
body.home-page {
  overflow-x: hidden;
  overflow-y: auto;
  background: var(--home-cream);
}

/* ───────────────────────────────────────────────
   GRAIN — très léger, chaleureux
   ─────────────────────────────────────────────── */
.home-grain {
  position: fixed; inset: 0;
  z-index: 9997;
  pointer-events: none;
  opacity: 0.022;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size: 200px;
  animation: home-grain-anim 0.6s steps(2) infinite;
}
@keyframes home-grain-anim {
  0%,100%{ transform:translate(0,0); }
  25%    { transform:translate(-1%,-2%); }
  75%    { transform:translate(2%,1%); }
}

/* ═══════════════════════════════════════════════
   INTRO OVERLAY — VIDÉO PLEIN ÉCRAN
   ═══════════════════════════════════════════════ */
#home-intro {
  position: fixed;
  inset: 0;
  z-index: 9500;
  background: #0a0500;
  overflow: hidden;
  /* Bloque le scroll pendant l'intro */
  touch-action: none;
}
#home-intro.hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 1.1s cubic-bezier(.16,1,.3,1), visibility 0s linear 1.1s;
}

/* La vidéo occupe tout l'écran */
#intro-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
}

/* Vignette douce sur les bords */
#intro-vignette {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    radial-gradient(ellipse at center, transparent 45%, rgba(10,5,0,0.38) 100%),
    linear-gradient(to bottom, rgba(10,5,0,0.12) 0%, transparent 20%, transparent 75%, rgba(10,5,0,0.25) 100%);
}

/* Barre de progression synchronisée sur la vidéo */
#intro-progress-bar {
  position: absolute;
  bottom: 0; left: 0;
  height: 3px; width: 0;
  z-index: 10;
  background: linear-gradient(90deg, #c4673a, #f0a060);
  box-shadow: 0 0 10px rgba(196,103,58,0.65);
}

/* Logo TravelMate centré pendant l'intro */
#intro-logo {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 5;
  text-align: center;
  opacity: 0;
  animation: home-fade 1.2s ease 0.3s forwards;
}
#intro-logo-name {
  font-family: var(--home-serif);
  font-size: clamp(2.5rem, 6vw, 5rem);
  font-weight: 300;
  color: var(--home-cream);
  letter-spacing: 0.12em;
  text-shadow: 0 2px 40px rgba(0,0,0,0.5);
}
#intro-logo-name b {
  color: #f0a060;
  font-weight: 300;
}
#intro-logo-sub {
  font-family: var(--home-sans);
  font-size: 0.65rem;
  letter-spacing: 0.5em;
  text-transform: uppercase;
  color: rgba(253,248,242,0.55);
  margin-top: 8px;
}

/* Bouton Passer */
#intro-skip-btn {
  position: absolute;
  bottom: 30px; right: 34px;
  z-index: 10;
  background: rgba(253,248,242,0.08);
  border: 1px solid rgba(253,248,242,0.2);
  color: rgba(253,248,242,0.65);
  font-family: var(--home-sans);
  font-size: 0.68rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  padding: 8px 18px;
  border-radius: 40px;
  cursor: pointer;
  opacity: 1;
  transition: all .3s;
}
#intro-skip-btn:hover {
  background: rgba(196,103,58,0.28);
  border-color: rgba(196,103,58,0.55);
  color: #fff;
}

/* Scroll hint — apparaît vers la fin de la vidéo */
#intro-scroll-hint {
  position: absolute;
  bottom: 34px; left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  opacity: 0;
  cursor: pointer;
  z-index: 10;
}
#intro-scroll-hint.show {
  animation: home-fade .8s ease forwards;
}
.intro-scroll-label {
  font-family: var(--home-sans);
  font-size: 0.6rem;
  letter-spacing: 0.38em;
  text-transform: uppercase;
  color: rgba(253,248,242,0.6);
}
.intro-scroll-bar {
  width: 1px;
  height: 44px;
  background: linear-gradient(to bottom, #f0a060, transparent);
  animation: intro-bar-anim 1.5s ease-in-out infinite;
}
@keyframes intro-bar-anim {
  0%  { transform:scaleY(0); transform-origin:top; }
  50% { transform:scaleY(1); transform-origin:top; }
  51% { transform:scaleY(1); transform-origin:bottom; }
  100%{ transform:scaleY(0); transform-origin:bottom; }
}

@keyframes home-fade { to { opacity:1; } }
@keyframes home-fade-up {
  from { opacity:0; transform:translateY(12px); }
  to   { opacity:1; transform:translateY(0); }
}

/* ═══════════════════════════════════════════════
   HERO — Vidéo fin.mp4 en background (boucle)
   ═══════════════════════════════════════════════ */
.home-cinematic-hero {
  height: 100vh;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  padding: 0 7vw 9vh;
}

/* Vidéo hero en background, en boucle silencieuse */
#hero-bg-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(0.52) saturate(1.15) sepia(0.12);
  transform: scale(1.05);
  will-change: transform;
  z-index: 0;
}

/* Vignette chaude */
.hch-vignette {
  position: absolute; inset: 0;
  z-index: 1;
  background:
    linear-gradient(to bottom,
      rgba(253,235,200,0.05) 0%,
      transparent 25%,
      transparent 45%,
      rgba(90,48,20,0.72) 100%
    );
}

/* Badge live */
.hch-badge {
  position: absolute; top:40px; right:7vw;
  display: flex; align-items: center; gap: 10px;
  background: rgba(253,248,242,0.15);
  backdrop-filter: blur(14px);
  border: 1px solid rgba(253,248,242,0.25);
  border-radius: 50px;
  padding: 10px 18px;
  z-index: 2;
  opacity: 0;
  animation: home-fade-up .8s ease 1.2s both;
}
.hch-badge-dot {
  width: 7px; height: 7px;
  background: #7ed9a0;
  border-radius: 50%;
  animation: hch-blink 2s ease infinite;
}
@keyframes hch-blink {
  0%,100%{ opacity:1; box-shadow:0 0 0 0 rgba(126,217,160,0.5); }
  50%{ opacity:.65; box-shadow:0 0 0 6px rgba(126,217,160,0); }
}
.hch-badge-text {
  font-family: var(--home-sans);
  font-size: 0.66rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(253,248,242,0.85);
}

/* Contenu hero */
.hch-content {
  position: relative; z-index: 2;
  max-width: 800px;
  opacity: 0;
  transform: translateY(36px);
  transition: opacity 1s ease, transform 1s ease;
}
.hch-content.vis { opacity:1; transform:translateY(0); }

.hch-eyebrow {
  font-family: var(--home-sans);
  font-size: 0.68rem;
  letter-spacing: 0.42em;
  text-transform: uppercase;
  color: #f0b070;
  margin-bottom: 20px;
  display: flex; align-items: center; gap: 14px;
}
.hch-eyebrow::before {
  content: '';
  display: block;
  width: 36px; height: 1px;
  background: #f0b070;
}

.hch-title {
  font-family: var(--home-serif);
  font-size: clamp(3rem, 6.5vw, 7rem);
  font-weight: 300;
  line-height: 0.96;
  color: var(--home-cream);
  letter-spacing: -0.01em;
  margin-bottom: 26px;
  text-shadow: 0 2px 30px rgba(40,20,5,0.4);
}
.hch-title em { font-style: italic; color: #f5c080; }

.hch-desc {
  font-family: var(--home-sans);
  font-size: 0.92rem;
  line-height: 1.78;
  color: rgba(253,248,242,0.75);
  max-width: 450px;
  margin-bottom: 38px;
  letter-spacing: 0.025em;
}

.hch-actions { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }

/* Bouton primaire — orange chaleureux */
.hch-btn-primary {
  display: inline-flex; align-items: center; gap: 10px;
  background: var(--home-orange);
  color: #fff;
  font-family: var(--home-sans);
  font-size: 0.74rem;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  padding: 15px 30px;
  text-decoration: none;
  border-radius: 6px;
  transition: all .3s cubic-bezier(.16,1,.3,1);
  position: relative; overflow: hidden;
  box-shadow: 0 8px 30px rgba(196,103,58,0.4);
}
.hch-btn-primary::before {
  content: '';
  position: absolute; inset:0;
  background: rgba(255,255,255,0.12);
  transform: translateX(-110%);
  transition: transform .4s cubic-bezier(.16,1,.3,1);
}
.hch-btn-primary:hover::before { transform:translateX(0); }
.hch-btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 18px 50px rgba(196,103,58,0.5);
  color: #fff;
}

/* Bouton fantôme clair */
.hch-btn-ghost {
  font-family: var(--home-sans);
  font-size: 0.74rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(253,248,242,0.7);
  text-decoration: none;
  display: flex; align-items: center; gap: 10px;
  transition: color .3s;
}
.hch-btn-ghost:hover { color: var(--home-cream); }
.hch-btn-ghost-arrow {
  width: 34px; height: 1px;
  background: currentColor; position: relative;
  transition: width .3s;
}
.hch-btn-ghost:hover .hch-btn-ghost-arrow { width: 52px; }
.hch-btn-ghost-arrow::after {
  content: '';
  position: absolute; right:0; top:-3px;
  width:6px; height:6px;
  border-right: 1px solid currentColor;
  border-top: 1px solid currentColor;
  transform: rotate(45deg);
}

/* ═══════════════════════════════════════════════
   SECTION ÉDITORIALE
   ═══════════════════════════════════════════════ */
.home-editorial {
  position: relative;
  height: 100vh;
  display: flex; align-items: center;
  overflow: hidden;
}
.hed-bg {
  position: absolute; inset: 0;
  background-size: cover;
  background-position: center;
  filter: brightness(0.38) saturate(1.3) sepia(0.2);
  transform: scale(1.03);
  transition: transform .9s ease;
}
.home-editorial:hover .hed-bg { transform: scale(1.0); }

.hed-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(
    135deg,
    rgba(90,45,15,0.62) 0%,
    rgba(150,80,30,0.15) 50%,
    transparent 75%
  );
}

.hed-content {
  position: relative; z-index: 2;
  padding: 0 8vw; width: 100%;
}
.hed-num {
  font-family: var(--home-sans);
  font-size: 0.66rem; letter-spacing: 0.44em;
  color: #f0b070; margin-bottom: 22px;
}
.hed-headline {
  font-family: var(--home-serif);
  font-size: clamp(3.5rem, 9vw, 11rem);
  font-weight: 300; line-height: 0.9;
  color: var(--home-cream);
  letter-spacing: -0.02em; text-transform: uppercase;
  text-shadow: 0 4px 40px rgba(40,15,5,0.5);
}
.hed-headline .hed-dim {
  font-style: italic;
  color: rgba(253,235,200,0.42);
}
.hed-sub {
  font-family: var(--home-sans);
  font-size: 0.82rem; letter-spacing: 0.14em;
  color: rgba(253,248,242,0.65);
  margin-top: 28px; text-transform: uppercase;
  max-width: 360px; line-height: 1.85;
}

/* ═══════════════════════════════════════════════
   SECTION DESTINATIONS
   ═══════════════════════════════════════════════ */
.home-destinations {
  padding: 110px 6vw 100px;
  background: var(--home-cream);
  position: relative;
  overflow: hidden;
}
.home-destinations::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--home-border), transparent);
}
.home-destinations::after {
  content: '';
  position: absolute;
  top: -80px; right: -100px;
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(196,103,58,0.07) 0%, transparent 70%);
  pointer-events: none;
}

.hdest-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 60px;
  flex-wrap: wrap;
  gap: 20px;
}
.hdest-label {
  font-family: var(--home-sans);
  font-size: 0.64rem; letter-spacing: 0.44em;
  text-transform: uppercase; color: var(--home-orange);
  margin-bottom: 12px;
}
.hdest-title {
  font-family: var(--home-serif);
  font-size: clamp(2.2rem, 4vw, 4.5rem);
  font-weight: 300;
  color: #2a1a0a;
  line-height: 1.08;
}
.hdest-title em { font-style: italic; color: rgba(42,26,10,0.42); }
.hdest-link {
  font-family: var(--home-sans);
  font-size: 0.72rem; letter-spacing: 0.16em;
  text-transform: uppercase; color: var(--home-orange);
  text-decoration: none; display: flex; align-items: center; gap: 10px;
  border-bottom: 1px solid rgba(196,103,58,0.3);
  padding-bottom: 3px;
  transition: border-color .3s, gap .3s;
  white-space: nowrap;
}
.hdest-link:hover { border-color: var(--home-orange); gap: 16px; }

/* ── LA GRILLE — identique au preview ── */
.hdest-grid {
  display: grid;
  grid-template-columns: 1.65fr 1fr 1fr;
  grid-template-rows: 460px 280px;
  gap: 4px;
  border-radius: var(--home-radius);
  overflow: hidden;
  box-shadow: var(--home-shadow);
}
.hdest-card {
  position: relative;
  overflow: hidden;
  cursor: pointer;
  background: var(--home-cream-3);
}
/* La première carte occupe les 2 lignes */
.hdest-card:first-child { grid-row: span 2; }

.hdest-card-img {
  position: absolute; inset: 0;
  background-size: cover;
  background-position: center;
  filter: brightness(0.58) saturate(1.1);
  transform: scale(1.05);
  transition: transform .8s cubic-bezier(.16,1,.3,1), filter .7s;
}
.hdest-card:hover .hdest-card-img {
  transform: scale(1);
  filter: brightness(0.72) saturate(1.2);
}
.hdest-card-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(50,22,5,0.88) 0%, transparent 52%);
}
.hdest-card-body {
  position: absolute; bottom:0; left:0; right:0;
  padding: 24px 22px;
  transform: translateY(6px);
  transition: transform .4s cubic-bezier(.16,1,.3,1);
}
.hdest-card:hover .hdest-card-body { transform: translateY(0); }
.hdest-card-tag {
  font-family: var(--home-sans);
  font-size: 0.57rem; letter-spacing: 0.32em;
  text-transform: uppercase; color: #f0b070;
  margin-bottom: 6px;
}
.hdest-card-name {
  font-family: var(--home-serif);
  font-size: 1.75rem; font-weight: 300;
  color: var(--home-cream); line-height: 1.05;
}
.hdest-card:first-child .hdest-card-name { font-size: 2.8rem; }
.hdest-card-meta {
  font-family: var(--home-sans);
  font-size: 0.63rem; letter-spacing: 0.1em;
  color: rgba(253,248,242,0.62); margin-top: 7px;
  opacity: 0; transform: translateY(5px);
  transition: opacity .4s .1s, transform .4s .1s;
}
.hdest-card:hover .hdest-card-meta { opacity:1; transform:translateY(0); }

/* ═══════════════════════════════════════════════
   STATISTIQUES
   ═══════════════════════════════════════════════ */
.home-stats {
  padding: 110px 8vw;
  background: var(--home-cream-2);
  position: relative;
  overflow: hidden;
}
.home-stats::before {
  content: '';
  position: absolute; bottom:-110px; left:-110px;
  width: 460px; height: 460px;
  background: radial-gradient(circle, rgba(196,103,58,0.07) 0%, transparent 70%);
  pointer-events: none;
}
.hstats-label {
  font-family: var(--home-sans);
  font-size: 0.65rem; letter-spacing: 0.44em;
  text-transform: uppercase; color: var(--home-orange);
  margin-bottom: 52px;
}
.hstats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  max-width: 800px;
}
.hstat-item {
  padding-right: 46px; margin-right: 46px;
  border-right: 1px solid var(--home-border);
}
.hstat-item:last-child { border:none; padding:0; margin:0; }
.hstat-num {
  font-family: var(--home-serif);
  font-size: clamp(3rem, 5.5vw, 5.5rem);
  font-weight: 300; color: #2a1a0a;
  line-height: 1; margin-bottom: 10px;
}
.hstat-num span { color: var(--home-orange); }
.hstat-desc {
  font-family: var(--home-sans);
  font-size: 0.7rem; letter-spacing: 0.17em;
  text-transform: uppercase; color: var(--home-warm-muted);
  line-height: 1.65;
}

/* ═══════════════════════════════════════════════
   FONCTIONNEMENT
   ═══════════════════════════════════════════════ */
.home-how {
  padding: 120px 7vw;
  background: var(--home-cream);
  position: relative;
  overflow: hidden;
}
.home-how::before {
  content: '';
  position: absolute; top:-100px; right:-100px;
  width: 460px; height: 460px;
  background: radial-gradient(circle, rgba(196,103,58,0.055) 0%, transparent 70%);
  pointer-events: none;
}
.hhow-title {
  font-family: var(--home-serif);
  font-size: clamp(2rem, 4.5vw, 5rem);
  font-weight: 300; color: #2a1a0a;
  line-height: 1.05; margin-bottom: 70px;
}
.hhow-title em { font-style: italic; color: rgba(42,26,10,0.38); }
.hhow-steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  background: var(--home-border);
  border-radius: var(--home-radius);
  overflow: hidden;
  box-shadow: var(--home-shadow);
}
.hhow-step {
  background: #fffaf4;
  padding: 40px 32px;
  position: relative;
  transition: background .4s;
  overflow: hidden;
}
.hhow-step::after {
  content: '';
  position: absolute; bottom:0; left:0;
  width:0; height:3px;
  background: var(--home-orange);
  transition: width .5s cubic-bezier(.16,1,.3,1);
}
.hhow-step:hover { background: rgba(196,103,58,0.04); }
.hhow-step:hover::after { width: 100%; }
.hhow-step-num {
  font-family: var(--home-serif);
  font-size: 3.5rem; font-weight: 300;
  color: rgba(196,103,58,0.12);
  line-height: 1; margin-bottom: 24px;
  transition: color .4s;
}
.hhow-step:hover .hhow-step-num { color: rgba(196,103,58,0.22); }
.hhow-step-icon {
  width: 42px; height: 42px;
  border: 1px solid rgba(196,103,58,0.25);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 16px; color: var(--home-orange);
  transition: border-color .3s, background .3s;
}
.hhow-step:hover .hhow-step-icon {
  border-color: var(--home-orange);
  background: rgba(196,103,58,0.08);
}
.hhow-step-title {
  font-family: var(--home-serif);
  font-size: 1.3rem; font-weight: 400;
  color: #2a1a0a; margin-bottom: 12px; line-height: 1.2;
}
.hhow-step-desc {
  font-family: var(--home-sans);
  font-size: 0.8rem; line-height: 1.75;
  color: var(--home-warm-muted); letter-spacing: 0.02em;
}

/* ═══════════════════════════════════════════════
   CTA FINAL
   ═══════════════════════════════════════════════ */
.home-cta {
  position: relative;
  height: 90vh;
  display: flex; align-items: center; justify-content: center;
  text-align: center; overflow: hidden;
}
.hcta-bg {
  position: absolute; inset: 0;
  background-image: url('https://images.unsplash.com/photo-1530521954074-e64f6810b32d?w=2000&q=85');
  background-size: cover;
