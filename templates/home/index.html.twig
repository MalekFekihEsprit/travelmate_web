}
.hcta-actions { display: flex; gap: 18px; justify-content: center; flex-wrap: wrap; }

/* ═══════════════════════════════════════════════
   SCROLL REVEAL — classe unique "sr" + "vis"
   ═══════════════════════════════════════════════ */
.sr {
  opacity: 0;
  transform: translateY(44px);
  transition: opacity .85s cubic-bezier(.16,1,.3,1),
              transform .85s cubic-bezier(.16,1,.3,1);
}
.sr.left  { transform: translateX(-44px); }
.sr.right { transform: translateX(44px); }
/* "vis" est la classe ajoutée par le JS — unifiée partout */
.sr.vis { opacity:1; transform:translate(0,0); }
.sr-d1 { transition-delay: .1s; }
.sr-d2 { transition-delay: .22s; }
.sr-d3 { transition-delay: .35s; }
.sr-d4 { transition-delay: .48s; }

/* ═══════════════════════════════════════════════
   RESPONSIVE
   ═══════════════════════════════════════════════ */
@media (max-width: 960px) {
  .hdest-grid {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto;
