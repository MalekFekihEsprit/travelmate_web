    padding-bottom: 28px; margin-bottom: 28px;
    padding-right: 0; margin-right: 0;
  }
  .hstat-item:last-child { border-bottom: none; padding-bottom: 0; margin-bottom: 0; }
}
@media (max-width: 640px) {
  .hhow-steps { grid-template-columns: 1fr; }
  .hdest-grid { grid-template-columns: 1fr; grid-template-rows: auto; }
  .hdest-header { flex-direction: column; align-items: flex-start; gap: 20px; }
  .hdest-card:first-child .hdest-card-name { font-size: 2.2rem; }
}
