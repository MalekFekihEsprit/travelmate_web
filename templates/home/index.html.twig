<!-- ═══════════════════════════════════════════
     INTRO — Vidéo plein écran (/public/fin.mp4)
     Se ferme automatiquement à la fin de la vidéo
     ou sur clic du bouton "Passer"
     ═══════════════════════════════════════════ -->
<div id="home-intro">

  <video
    id="intro-video"
    muted
    autoplay
    playsinline
    preload="auto"
  >
    <source src="/videos/fin.mp4" type="video/mp4">
  </video>

  <div id="intro-vignette"></div>

  <!-- Logo centré visible pendant l'intro -->
  <div id="intro-logo">
    <div id="intro-logo-name">Travel<b>Mate</b></div>
    <div id="intro-logo-sub">Voyages Collaboratifs</div>
  </div>

  <!-- Barre de progression -->
  <div id="intro-progress-bar"></div>

  <!-- Bouton Passer -->
  <button id="intro-skip-btn" type="button" onclick="window._skipIntro && window._skipIntro()">Passer</button>

  <!-- Scroll hint (apparaît à la fin) -->
  <div id="intro-scroll-hint" onclick="window._skipIntro && window._skipIntro()">
    <span class="intro-scroll-label">Défiler</span>
    <div class="intro-scroll-bar"></div>
  </div>

</div>

{# ── SCRIPT INTRO INLINE — doit être exécuté dès que le DOM est prêt,
   avant tout importmap/bundle, pour que skipIntro() soit disponible
   au moment où l'utilisateur clique sur "Passer" ── #}
<script>
(function () {
  'use strict';

  // Bloque le scroll pendant l'intro
  document.body.style.overflow = 'hidden';

  var introEl    = document.getElementById('home-intro');
  var introVideo = document.getElementById('intro-video');
  var progBar    = document.getElementById('intro-progress-bar');
  var scrollHint = document.getElementById('intro-scroll-hint');
  var skipBtn    = document.getElementById('intro-skip-btn');
  var introDone  = false;
  var safetyTimer = null;

  function skipIntro() {
    if (introDone) return;
    introDone = true;

    if (safetyTimer) clearTimeout(safetyTimer);

    // Stoppe la vidéo proprement
    if (introVideo) {
      try { introVideo.pause(); } catch(e) {}
      introVideo.removeAttribute('src');
      try { introVideo.load(); } catch(e) {}
    }

    // Réactive le scroll AVANT la transition
    document.body.style.overflow  = '';
    document.body.style.touchAction = '';

    // Fade-out overlay intro
    introEl.classList.add('hidden');

    // Lance la vidéo hero de fond
    var hv = document.getElementById('hero-bg-video');
    if (hv) {
      hv.muted = true;
      hv.load();
      hv.play().catch(function(){});
    }

    // Après la transition CSS (1.1s) : retire l'overlay et révèle le hero
    setTimeout(function () {
      introEl.style.display = 'none';
      var hc = document.getElementById('hch-content');
      if (hc) hc.classList.add('vis');

      // Ré-observe tous les éléments .sr pas encore visibles
      // (l'observer initial les a ratés car l'intro bloquait la vue)
      document.dispatchEvent(new CustomEvent('introEnded'));
    }, 1150);
  }

  // Expose globalement pour les onclick inline (au cas où)
  window._skipIntro = skipIntro;

  // Attache les listeners dès que le script s'exécute
  if (skipBtn)    skipBtn.addEventListener('click', skipIntro);
  if (scrollHint) scrollHint.addEventListener('click', skipIntro);

  // Timer de sécurité : 12s max quoi qu'il arrive
  safetyTimer = setTimeout(function () {
    if (!introDone) skipIntro();
  }, 12000);

  if (introVideo) {
    // Barre de progression
    introVideo.addEventListener('timeupdate', function () {
      if (!introVideo.duration || introVideo.duration === Infinity) return;
      var pct = (introVideo.currentTime / introVideo.duration) * 100;
      if (progBar) progBar.style.width = pct + '%';
      if (pct >= 88 && scrollHint) scrollHint.classList.add('show');
    });

    // Fin naturelle de la vidéo → skip automatique après 0.5s
    introVideo.addEventListener('ended', function () {
      if (scrollHint) scrollHint.classList.add('show');
      setTimeout(skipIntro, 500);
    });

    // Erreur → skip après 1s
    introVideo.addEventListener('error', function () {
      console.warn('[Intro] Erreur vidéo, skip automatique');
      setTimeout(function () { if (!introDone) skipIntro(); }, 1000);
    });

    // Lance la lecture (la vidéo a déjà autoplay + muted dans le HTML,
    // mais on force aussi via JS pour les navigateurs récalcitrants)
    var p = introVideo.play();
    if (p && typeof p.then === 'function') {
      p.catch(function (err) {
        console.warn('[Intro] Autoplay bloqué :', err);
        // Autoplay refusé même muet → affiche quand même le skip btn
        // et laisse l'utilisateur cliquer, ou le safety timer fera le skip
        if (skipBtn) skipBtn.style.opacity = '1';
      });
    }
  } else {
    // Pas de vidéo dans le DOM → skip direct
    skipIntro();
  }
})();
</script>

