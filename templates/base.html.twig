{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}TravelMate{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {# Apply dark mode & zoom BEFORE render to avoid flash #}
    <script>
        (function(){
            var d = localStorage.getItem('a11y_dark');
            var z = localStorage.getItem('a11y_zoom');
            if (d === '1') document.documentElement.setAttribute('data-theme','dark');
            if (z) document.documentElement.style.fontSize = (parseFloat(z)*100)+'%';
        })();
    </script>

    {# Polices sobres et modernes #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Fraunces:wght@500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    {% block javascripts %}
        {{ importmap('app') }}
    {% endblock %}
    {% block stylesheets %}
        {{ importmap('app') }}
    {% endblock %}
    <style>
        /* ── Traduction dans la navbar ── */
        .navbar-lang {
            position: relative;
        }
        .navbar-lang__btn {
            color: var(--color-text-muted);
            transition: color var(--transition-fast), background var(--transition-fast);
        }
        .navbar-lang__btn:hover,
        .navbar-lang.is-open .navbar-lang__btn {
            color: var(--color-primary);
            background: var(--color-hover);
            border-radius: 50%;
        }
        .navbar-lang__panel {
            display: none;
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            min-width: 190px;
            background: #fff;
            border: 1px solid rgba(196,111,75,0.15);
            border-radius: 14px;
            padding: 0.5rem 0.5rem;
            box-shadow: 0 8px 32px rgba(0,0,0,0.13);
            z-index: 9999;
            flex-direction: column;
            gap: 0.2rem;
        }
        .navbar-lang__panel.is-open { display: flex; }
        .navbar-lang__panel-title {
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #b0a09a;
            padding: 0.2rem 0.5rem 0.4rem;
        }
        .lang-option {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.48rem 0.75rem;
            border-radius: 8px;
            border: none;
            background: transparent;
            font: inherit;
            font-size: 0.88rem;
            color: #3d322d;
            cursor: pointer;
            transition: background 150ms ease, color 150ms ease;
            text-align: left;
            width: 100%;
        }
        .lang-option:hover { background: rgba(196,111,75,0.08); }
        .lang-option.is-active {
            background: rgba(196,111,75,0.12);
            color: var(--color-primary, #c46f4b);
            font-weight: 600;
        }
        .lang-option__flag { font-size: 1.1rem; flex-shrink: 0; }
        .lang-option__label { flex: 1; }
        .lang-option__check {
            font-size: 0.8rem;
            color: var(--color-primary, #c46f4b);
            display: none;
        }
        .lang-option.is-active .lang-option__check { display: block; }
        .translate-loading-bar {
            position: fixed;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: var(--color-primary, #c46f4b);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.3s ease;
            z-index: 99999;
            border-radius: 0 999px 999px 0;
        }
        .translate-loading-bar.is-loading { transform: scaleX(0.7); }
        .translate-loading-bar.is-done    { transform: scaleX(1); transition: transform 0.15s ease; }
        [data-theme="dark"] .navbar-lang__panel {
            background: #2a2320;
            border-color: rgba(196,111,75,0.2);
        }
        [data-theme="dark"] .lang-option { color: #d4c4bc; }
        [data-theme="dark"] .lang-option:hover { background: rgba(196,111,75,0.12); }
    </style>
</head>
<body>
<div class="app-shell">
    {# -----------------------------------------
       Configuration simple des items de menu
       Adapte les routes Symfony selon ton projet
    ------------------------------------------ #}
    {% set currentRoute = app.request.attributes.get('_route') %}

    {# Détection active élargie par famille de routes #}
    {% set isDestination   = currentRoute in ['app_destination_index', 'app_destination_show'] %}
    {% set isHebergement   = currentRoute in ['app_hebergement_index', 'app_hebergement_show'] %}
    {% set isEvenement     = currentRoute in ['app_evenements', 'app_evenement_show'] %}
    {% set isVoyage        = currentRoute in ['app_voyages', 'app_voyages_show', 'app_voyages_participants', 'app_itineraires_index', 'app_itineraires_create', 'app_etapes_jour', 'app_etapes_create'] %}
    {% set isBudget        = currentRoute starts with 'app_budget' %}
    {% set isActivite      = currentRoute starts with 'app_activit' or currentRoute in ['app_categories', 'app_categorie_show'] %}

    {% set navBeforeItems = [
        { label: 'Accueil',        route: 'app_home',              href: path('app_home'),              active: currentRoute == 'app_home' },
        { label: 'Destinations',   route: 'app_destination_index', href: path('app_destination_index'), active: isDestination },
        { label: 'Hébergements',   route: 'app_hebergement_index', href: path('app_hebergement_index'), active: isHebergement },
    ] %}
    {% set navAfterItems = [
        { label: 'Événements',     route: 'app_evenements',        href: path('app_evenements'),        active: isEvenement },
        { label: 'Voyages',        route: 'app_voyages',           href: path('app_voyages'),           active: isVoyage },
        { label: 'Budgets',        route: 'app_budget_index',      href: path('app_budget_index'),      active: isBudget },
    ] %}

    <header class="app-navbar">
        <div class="app-navbar__inner">
            {# Logo #}
            <a href="{{ path('app_home') }}" class="brand" aria-label="Aller à l'accueil TravelMate">
                <span class="brand__mark" aria-hidden="true">
                {# Image located in travelmate_web/assets/images/logo.png #}
                <img src="{{ asset('images/logo.png') }}" alt="Logo">
                    
                </span>

                <span class="brand__text">
                    <span class="brand__title">TravelMate</span>
                    <span class="brand__subtitle">voyages collaboratifs</span>
                </span>
            </a>

            {# Navigation principale #}
            <div class="nav-wrap">
                <nav class="main-nav" aria-label="Navigation principale">
                    {% for item in navBeforeItems %}
                        <a href="{{ item.href }}" class="main-nav__link {{ item.active ? 'is-active' : '' }}">{{ item.label }}</a>
                    {% endfor %}

                    {# Activités + Catégories fusionnées en dropdown #}
                    <div class="nav-dropdown">
                        <button type="button"
                                class="main-nav__link nav-dropdown__trigger {{ isActivite ? 'is-active' : '' }}"
                                aria-haspopup="true" aria-expanded="false">
                            Activités
                            <svg class="nav-dropdown__chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                        <div class="nav-dropdown__menu" role="menu">
                            <a href="{{ path('app_activites') }}"
                               class="nav-dropdown__choice {{ currentRoute starts with 'app_activit' ? 'is-active' : '' }}"
                               role="menuitem">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M4 6h16M4 10h16M4 14h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                </svg>
                                Toutes les activités
                            </a>
                            <a href="{{ path('app_categories') }}"
                               class="nav-dropdown__choice {{ currentRoute in ['app_categories', 'app_categorie_show'] ? 'is-active' : '' }}"
                               role="menuitem">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                                </svg>
                                Par catégorie
                            </a>
                        </div>
                    </div>

                    {% for item in navAfterItems %}
                        <a href="{{ item.href }}" class="main-nav__link {{ item.active ? 'is-active' : '' }}">{{ item.label }}</a>
                    {% endfor %}
                </nav>
            </div>

            {# Actions à droite #}
            <div class="navbar-actions">
                {# Traduction #}
                <div class="navbar-lang" id="navbarLang">
                    <button type="button" class="icon-button navbar-lang__btn" id="langToggleBtn" title="Changer de langue" aria-haspopup="true" aria-expanded="false" onclick="event.stopPropagation(); toggleLangPanel()">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z" stroke="currentColor" stroke-width="1.7"/>
                            <path d="M3.6 9h16.8M3.6 15h16.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                            <path d="M12 3c-2 2.5-3 5-3 9s1 6.5 3 9M12 3c2 2.5 3 5 3 9s-1 6.5-3 9" stroke="currentColor" stroke-width="1.7"/>
                        </svg>
                    </button>
                    <div class="navbar-lang__panel" id="langPanel">
                        <div class="navbar-lang__panel-title">Langue / Language</div>
                        <button type="button" class="lang-option is-active" data-lang="fr" onclick="setLanguage('fr')">
                            <span class="lang-option__flag">🇫🇷</span><span class="lang-option__label">Français</span><span class="lang-option__check">✓</span>
                        </button>
                        <button type="button" class="lang-option" data-lang="en" onclick="setLanguage('en')">
                            <span class="lang-option__flag">🇬🇧</span><span class="lang-option__label">English</span><span class="lang-option__check">✓</span>
                        </button>
                        <button type="button" class="lang-option" data-lang="ar" onclick="setLanguage('ar')">
                            <span class="lang-option__flag">🇹🇳</span><span class="lang-option__label">العربية</span><span class="lang-option__check">✓</span>
                        </button>
                        <button type="button" class="lang-option" data-lang="de" onclick="setLanguage('de')">
                            <span class="lang-option__flag">🇩🇪</span><span class="lang-option__label">Deutsch</span><span class="lang-option__check">✓</span>
                        </button>
                        <button type="button" class="lang-option" data-lang="es" onclick="setLanguage('es')">
                            <span class="lang-option__flag">🇪🇸</span><span class="lang-option__label">Español</span><span class="lang-option__check">✓</span>
                        </button>
                        <button type="button" class="lang-option" data-lang="it" onclick="setLanguage('it')">
                            <span class="lang-option__flag">🇮🇹</span><span class="lang-option__label">Italiano</span><span class="lang-option__check">✓</span>
                        </button>
                    </div>
                </div>

                {# Notifications #}
                <div class="notif-bell-wrapper" style="position:relative;">
                    <button class="icon-button" type="button" id="notifBellBtn" aria-label="Notifications">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M15 18H9M17 8C17 5.23858 14.7614 3 12 3C9.23858 3 7 5.23858 7 8V10.7639C7 11.4233 6.87041 12.0763 6.61803 12.6851L5.16568 16.1894C4.75614 17.1774 5.48244 18.25 6.55104 18.25H17.449C18.5176 18.25 19.2439 17.1774 18.8343 16.1894L17.382 12.6851C17.1296 12.0763 17 11.4233 17 10.7639V8Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span class="icon-button__badge" id="notifBadge" style="display:none;">0</span>
                    </button>

                    <div id="notifDropdown" style="display:none; position:absolute; top:calc(100% + 10px); right:0; width:350px; max-height:400px; background:#fff; border-radius:12px; box-shadow:0 8px 32px rgba(0,0,0,0.18); z-index:9999; overflow:hidden; border:1px solid rgba(0,0,0,0.07);">
                        <div style="display:flex; align-items:center; justify-content:space-between; padding:12px 16px; border-bottom:1px solid #f0f0f0;">
                            <span style="font-weight:600; font-size:0.9rem; color:#222;">Rappels de voyage</span>
                            <button id="notifDismissAllBtn" type="button" style="background:none; border:none; color:#c46f4b; font-size:0.78rem; cursor:pointer; padding:0;">Tout ignorer</button>
                        </div>
                        <div id="notifList" style="overflow-y:auto; max-height:320px;">
                            <p style="text-align:center; color:#aaa; padding:24px; margin:0; font-size:0.85rem;">Aucun rappel</p>
                        </div>
                    </div>
                </div>

                {# Profil #}
                <div class="profile-menu">
                    <button class="profile-menu__trigger" type="button" aria-label="Ouvrir le menu profil">
                        {% if app.user  %}
                            <img src="{{ app.user.profileImage }}" alt="Photo de profil" class="profile-menu__avatar">
                        {% else %}
                            <img
                                class="profile-menu__avatar"
                                src="{{ asset('images/profile-default.png') }}"
                                alt="Photo de profil"
                            >
                        {% endif %}

                        <span class="profile-menu__meta">
                            <span class="profile-menu__name">
                                {{ app.user ? app.user.prenom ~ ' ' ~ app.user.nom : 'Mon profil' }}
                            </span>
                            <span class="profile-menu__role">
                                {% if app.user  %}
                                    {% if app.user.role == 'USER' %}
                                        Utilisateur
                                    {% elseif app.user.role == 'ADMIN' %}
                                        Administrateur
                                    {% endif %}
                                {% else %}
                                    Visiteur
                                {% endif %}
                            </span>
                        </span>

                        <span class="profile-menu__chevron" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                    </button>

                    <div class="profile-dropdown">
                        <div class="profile-dropdown__header">
                            <div class="profile-dropdown__title">
                                {{ app.user ? app.user.userIdentifier : 'Compte utilisateur' }}
                            </div>
                            <div class="profile-dropdown__text">
                                Gérez votre espace TravelMate
                            </div>
                        </div>

                        <a href="{{ path('app_my_reservations') }}" class="profile-dropdown__link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2M9 11h6M11 15h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                            </svg>
                            <span>Gérer mes réservations</span>
                        </a>

                        <a href="{{ path('app_profile') }}"  class="profile-dropdown__link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M12 12C14.7614 12 17 9.76142 17 7C17 4.23858 14.7614 2 12 2C9.23858 2 7 4.23858 7 7C7 9.76142 9.23858 12 12 12Z" stroke="currentColor" stroke-width="1.7"/>
                                <path d="M4 21C4 17.6863 7.58172 15 12 15C16.4183 15 20 17.6863 20 21" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                            </svg>
                            <span>Voir mon profil</span>
                        </a>

                        <a href="#" {# path('app_settings') #} class="profile-dropdown__link">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M12 8.75C10.2051 8.75 8.75 10.2051 8.75 12C8.75 13.7949 10.2051 15.25 12 15.25C13.7949 15.25 15.25 13.7949 15.25 12C15.25 10.2051 13.7949 8.75 12 8.75Z" stroke="currentColor" stroke-width="1.7"/>
                                <path d="M19.4 15C19.2667 15.3 19.1667 15.6167 19.1 15.95L20.35 17.25L17.25 20.35L15.95 19.1C15.6167 19.1667 15.3 19.2667 15 19.4L14.5 21H9.5L9 19.4C8.7 19.2667 8.38333 19.1667 8.05 19.1L6.75 20.35L3.65 17.25L4.9 15.95C4.83333 15.6167 4.73333 15.3 4.6 15L3 14.5V9.5L4.6 9C4.73333 8.7 4.83333 8.38333 4.9 8.05L3.65 6.75L6.75 3.65L8.05 4.9C8.38333 4.83333 8.7 4.73333 9 4.6L9.5 3H14.5L15 4.6C15.3 4.73333 15.6167 4.83333 15.95 4.9L17.25 3.65L20.35 6.75L19.1 8.05C19.1667 8.38333 19.2667 8.7 19.4 9L21 9.5V14.5L19.4 15Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                            </svg>
                            <span>Paramètres</span>
                        </a>

                        <div class="profile-dropdown__footer">
                            <a href="{{ path('app_logout') }}" class="profile-dropdown__logout">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M15 17L20 12L15 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M20 12H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                    <path d="M12 20H6C4.89543 20 4 19.1046 4 18V6C4 4.89543 4.89543 4 6 4H12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                </svg>
                                <span>Se déconnecter</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="app-main">
        <div class="app-main__inner">

            {% if app.request.attributes.get('_route') == 'app_home' %}
                <section class="home-hero">
                    <div class="home-hero__content">
                        <div class="home-hero__text">
                            <span class="home-hero__eyebrow">Explorez autrement avec TravelMate</span>

                            <h1 class="home-hero__title">
                                Planifiez vos voyages avec envie, simplicité et liberté.
                            </h1>

                            <p class="home-hero__description">
                                Trouvez l’inspiration, organisez vos séjours, collaborez avec vos proches
                                et gardez chaque idée de voyage dans un espace clair et agréable.
                            </p>

                            <div class="home-hero__actions">
                                <a href="{{ path('app_voyages') }}" class="btn btn--primary">
                                    Créer mon voyage
                                </a>
                                <a href="#"{# path('app_destinations') #} class="btn btn--ghost">
                                    Explorer
                                </a>
                            </div>
                        </div>

                        <div class="home-hero__media">
                            <div class="hero-visual-card">
                                <img
                                    src="{{ asset('images/hero-img1.png') }}"
                                    alt="TravelMate inspiration voyage"
                                    class="hero-visual-card__image"
                                >
                            </div>
                        </div>
                    </div>
                </section>
            {% endif %}

            {% block body %}{% endblock %}
        </div>
    </main>

    <footer class="site-footer">
        <div class="site-footer__inner">
            <div class="site-footer__grid">
                <div class="site-footer__brand">
                    <a href="{{ path('app_home') }}" class="brand brand--footer">
                        <span class="brand__mark" aria-hidden="true">
                            {# Image located in travelmate_web/assets/images/logo.png #}
                            <img src="{{ asset('images/logo.png') }}" alt="Logo">
                                
                        </span>

                        <span class="brand__text">
                            <span class="brand__title">TravelMate</span>
                            <span class="brand__subtitle">voyages collaboratifs</span>
                        </span>
                    </a>

                    <p class="site-footer__tagline">
                        Préparez vos voyages plus sereinement, collaborez facilement et gardez
                        le contrôle sur chaque détail de votre aventure.
                    </p>
                </div>

                <div class="site-footer__column">
                    <h3 class="site-footer__heading">Plateforme</h3>
                    <ul class="site-footer__links">
                        <li><a href="{{ path('app_home') }}">Accueil</a></li>
                        <li><a href="#"{# path('app_destinations') #}>Destinations</a></li>
                        <li><a href="#"{# path('app_hebergements') #}>Hébergements</a></li>
                        <li><a href="{{ path('app_activites') }}">Activités</a></li>
                    </ul>
                </div>

                <div class="site-footer__column">
                    <h3 class="site-footer__heading">Organisation</h3>
                    <ul class="site-footer__links">
                        <li><a href="{{ path('app_voyages') }}">Voyages</a></li>
                        <li><a href="#"{# path('app_budgets') #}>Budgets</a></li>
                        <li><a href="{{ path('app_categories') }}">Catégories</a></li>
                        <li><a href="{{ path('app_profile') }}">Mon profil</a></li>
                    </ul>
                </div>

                <div class="site-footer__column">
                    <h3 class="site-footer__heading">Restez connectés</h3>

                    <p class="site-footer__text">
                        Suivez TravelMate et trouvez l’inspiration pour votre prochaine escapade.
                    </p>

                    <div class="site-footer__socials">
                        <a href="#" class="social-link" aria-label="Instagram">
                            <span>IG</span>
                        </a>
                        <a href="#" class="social-link" aria-label="Facebook">
                            <span>FB</span>
                        </a>
                        <a href="#" class="social-link" aria-label="Twitter">
                            <span>X</span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="site-footer__bottom">
                <p>© {{ "now"|date("Y") }} TravelMate. Tous droits réservés.</p>
                <div class="site-footer__bottom-links">
                    <a href="#">Confidentialité</a>
                    <a href="#">Conditions</a>
                    <a href="#">Support</a>
                </div>
            </div>
        </div>
    </footer>
</div>

<script>
(function () {
    var bellBtn      = document.getElementById('notifBellBtn');
    var badge        = document.getElementById('notifBadge');
    var dropdown     = document.getElementById('notifDropdown');
    var notifList    = document.getElementById('notifList');
    var dismissAllBtn= document.getElementById('notifDismissAllBtn');
    if (!bellBtn) return;

    var open = false;

    bellBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        open = !open;
        dropdown.style.display = open ? 'block' : 'none';
        if (open) loadNotifications();
    });

    document.addEventListener('click', function (e) {
        if (open && !dropdown.contains(e.target)) {
            open = false;
            dropdown.style.display = 'none';
        }
    });

    function loadNotifications() {
        fetch('/api/notifications/upcoming', { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                setBadge(data.count);
                renderList(data.notifications || []);
            })
            .catch(function () {});
    }

    function setBadge(n) {
        if (n > 0) {
            badge.textContent = n > 99 ? '99+' : String(n);
            badge.style.display = '';
        } else {
            badge.style.display = 'none';
        }
    }

    function renderList(items) {
        if (items.length === 0) {
            notifList.innerHTML = '<p style="text-align:center;color:#aaa;padding:24px;margin:0;font-size:0.85rem;">Aucun rappel</p>';
            return;
        }
        var html = '';
        items.forEach(function (n) {
            html += '<div style="display:flex;gap:12px;align-items:flex-start;padding:12px 16px;border-bottom:1px solid #f7f7f7;">';
            html += '<div style="flex-shrink:0;width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#c46f4b,#e8a87c);display:flex;align-items:center;justify-content:center;font-size:1.2rem;">🧳</div>';
            html += '<div style="flex:1;min-width:0;">';
            html += '<p style="margin:0 0 3px;font-size:0.84rem;color:#333;line-height:1.4;">' + escHtml(n.message) + '</p>';
            if (n.destination) html += '<span style="font-size:0.75rem;color:#888;">' + escHtml(n.destination) + '</span>';
            html += '</div>';
            html += '<button data-vid="' + n.voyage_id + '" title="Ignorer" style="flex-shrink:0;background:none;border:none;color:#ccc;font-size:1rem;cursor:pointer;padding:2px 4px;line-height:1;">&times;</button>';
            html += '</div>';
        });
        notifList.innerHTML = html;

        notifList.querySelectorAll('[data-vid]').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                var vid = btn.getAttribute('data-vid');
                fetch('/api/notifications/' + vid + '/dismiss', { method: 'POST', credentials: 'same-origin' })
                    .then(function () { loadNotifications(); });
            });
        });
    }

    dismissAllBtn.addEventListener('click', function () {
        fetch('/api/notifications/dismiss-all', { method: 'POST', credentials: 'same-origin' })
            .then(function () { loadNotifications(); });
    });

    function escHtml(s) {
        var d = document.createElement('div');
        d.appendChild(document.createTextNode(s || ''));
        return d.innerHTML;
    }

    // Initial badge load (no dropdown)
    fetch('/api/notifications/upcoming', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (d) { setBadge(d.count); })
        .catch(function () {});

    // Refresh every 60s
    setInterval(function () {
        fetch('/api/notifications/upcoming', { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (d) { setBadge(d.count); if (open) renderList(d.notifications || []); })
            .catch(function () {});
    }, 60000);
})();

// ── Nav dropdown Activités ──────────────────────────────────────────────
(function () {
    var dropdowns = document.querySelectorAll('.nav-dropdown');
    dropdowns.forEach(function (dd) {
        var trigger = dd.querySelector('.nav-dropdown__trigger');
        if (!trigger) return;

        trigger.addEventListener('click', function (e) {
            e.stopPropagation();
            var isOpen = dd.classList.toggle('is-open');
            trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
    });

    document.addEventListener('click', function () {
        dropdowns.forEach(function (dd) {
            dd.classList.remove('is-open');
            var trigger = dd.querySelector('.nav-dropdown__trigger');
            if (trigger) trigger.setAttribute('aria-expanded', 'false');
        });
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            dropdowns.forEach(function (dd) {
                dd.classList.remove('is-open');
                var trigger = dd.querySelector('.nav-dropdown__trigger');
                if (trigger) { trigger.setAttribute('aria-expanded', 'false'); trigger.focus(); }
            });
        }
    });
})();

// ── toggleLangPanel / setLanguage (standalone + enrichi par la librairie) ──
window.toggleLangPanel = window.toggleLangPanel || function () {
    var panel   = document.getElementById('langPanel');
    var wrapper = document.getElementById('navbarLang');
    var btn     = document.getElementById('langToggleBtn');
    if (!panel) return;
    var isOpen = panel.classList.toggle('is-open');
    if (wrapper) wrapper.classList.toggle('is-open', isOpen);
    if (btn)     btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
};
window.setLanguage = window.setLanguage || function (lang) {
    document.querySelectorAll('.lang-option').forEach(function (o) {
        o.classList.toggle('is-active', o.getAttribute('data-lang') === lang);
    });
    var panel   = document.getElementById('langPanel');
    var wrapper = document.getElementById('navbarLang');
    var btn     = document.getElementById('langToggleBtn');
    if (panel)   panel.classList.remove('is-open');
    if (wrapper) wrapper.classList.remove('is-open');
    if (btn)     btn.setAttribute('aria-expanded', 'false');
    if (window.TravelMateTranslate) { TravelMateTranslate.setLanguage(lang); }
};
document.addEventListener('click', function (e) {
    var wrapper = document.getElementById('navbarLang');
    if (!wrapper || wrapper.contains(e.target)) return;
    var panel = document.getElementById('langPanel');
    var btn   = document.getElementById('langToggleBtn');
    if (panel)   panel.classList.remove('is-open');
    if (wrapper) wrapper.classList.remove('is-open');
    if (btn)     btn.setAttribute('aria-expanded', 'false');
});
</script>

