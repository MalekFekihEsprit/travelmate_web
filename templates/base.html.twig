}
.chat-fab__tooltip {
    position: absolute;
    left: 66px;
    top: 50%;
    transform: translateY(-50%);
    background: #3b2a20;
    color: #fff;
    padding: 0.4rem 0.85rem;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease;
}
.chat-fab:hover .chat-fab__tooltip { opacity: 1; }

/* Panneau de chat */
.chat-panel {
    position: fixed;
    bottom: 5.5rem;
    left: 2rem;
    width: 340px;
    max-height: 460px;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 12px 40px rgba(0,0,0,0.18);
    display: flex;
    flex-direction: column;
    z-index: 8999;
    overflow: hidden;
    transform: scale(0.9) translateY(20px);
    transform-origin: bottom left;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
}
.chat-panel.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1) translateY(0);
}
.chat-panel__header {
    background: #3b2a20;
    color: #fff;
    padding: 0.85rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    font-size: 0.9rem;
    flex-shrink: 0;
}
.chat-panel__header-dot {
    width: 9px; height: 9px;
    background: #22c55e;
    border-radius: 50%;
    flex-shrink: 0;
}
.chat-panel__close {
    margin-left: auto;
    background: none;
    border: none;
